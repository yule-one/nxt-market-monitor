KIS_APP_KEY = "your-kis-app-key"
KIS_APP_SECRET = "your-kis-app-secret"
KRX_KEY = "your-krx-open-api-key"

# PostgreSQL을 설정하면 계정·권한·감사기록을 영구 DB에 저장합니다.
# 비밀번호가 포함되므로 실제 값은 GitHub에 올리지 마세요.
AUTH_DATABASE_URL = "postgresql://user:password@host:5432/database?sslmode=require"

# 선택사항: 초기 관리자 생성 화면을 보호하는 일회성 설정 토큰입니다.
# 외부에서 접근 가능한 환경에서는 반드시 길고 임의적인 값으로 설정하세요.
AUTH_SETUP_TOKEN = "replace-with-a-long-random-setup-token"
